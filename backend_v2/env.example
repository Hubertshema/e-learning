# ========================================================
# Backend Environment Variables (Render)
# ========================================================

NODE_ENV=production
PORT=5000

# PostgreSQL Connection String (Neon, Supabase, or Render Postgres)
# Example: postgres://username:password@hostname:5432/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Database SSL configuration (defaults to true in production or if neon/render/supabase URL)
DATABASE_SSL=true

# Database pool max connections
PG_POOL_MAX=20

# JWT Configuration (Change these to long, random 32+ character strings)
JWT_ACCESS_SECRET="super-secret-access-token-jwt-key-change-in-production-min32char"
JWT_REFRESH_SECRET="super-secret-refresh-token-jwt-key-change-in-production-min32char"
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# CORS & URLs (Comma-separated allowed origins, e.g. https://your-app.vercel.app)
# All *.vercel.app preview URLs are automatically supported!
FRONTEND_URL="https://your-app.vercel.app,http://localhost:3000"

# Cloudinary Media Storage (Uploads)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# AI Integration Keys (Groq & Google Gemini)
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"

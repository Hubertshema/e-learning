NODE_ENV=development
PORT=5000
DATABASE_URL="postgresql://user:password@host/database?sslmode=verify-full"

# JWT Configuration
JWT_ACCESS_SECRET="super-secret-access-token-jwt-key-min32char"
JWT_REFRESH_SECRET="super-secret-refresh-token-jwt-key-min32char"
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# CORS & URLs
FRONTEND_URL="http://localhost:3000"

# AI Provider Configuration
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"

# SMTP Mailer Configuration (For Localhost or VPS with open SMTP ports)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-char-app-password"
SMTP_FROM="LinguaChris Academy <your-email@gmail.com>"
ADMIN_NOTIFICATION_EMAIL="admissions@linguachris.com"

# Cloud / Render REST API Email Service (REQUIRED for Render Free Tier)
# Render Free strictly blocks raw SMTP ports (25, 465, 587).
# Use Resend or Brevo over HTTPS (Port 443) - zero timeouts and free.
# Option 1: Resend (https://resend.com - 3,000 free emails/month, 1 min setup)
RESEND_API_KEY=""
RESEND_FROM="LinguaChris Academy <onboarding@resend.dev>"

# Option 2: Brevo (https://brevo.com - 300 free emails/day)
# BREVO_API_KEY="xkeysib-..."
# BREVO_FROM_NAME="LinguaChris Academy"
# BREVO_FROM_EMAIL="pacich112@gmail.com"

NODE_ENV=development
PORT=5000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/elearning_db?schema=public"

# JWT Configuration
JWT_ACCESS_SECRET="super-secret-access-token-jwt-key-change-in-production-min32char"
JWT_REFRESH_SECRET="super-secret-refresh-token-jwt-key-change-in-production-min32char"
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# CORS & URLs
FRONTEND_URL="http://localhost:3000"

# Storage Configuration
STORAGE_PROVIDER="local"
STORAGE_BUCKET="elearning-uploads"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# Email Configuration (SMTP / Gmail App Password)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-char-app-password"
EMAIL_FROM="English Learning Platform <your-email@gmail.com>"

# AI Provider Configuration (Groq & Google Gemini)
GROQ_API_KEY="your-groq-api-key"
GROQ_MODEL="llama-3.3-70b-versatile"
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-1.5-flash"
